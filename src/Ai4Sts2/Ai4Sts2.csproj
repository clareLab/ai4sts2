<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <RootNamespace>Ai4Sts2</RootNamespace>
    <AssemblyName>ai4sts2</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>0.0.1</Version>
    <NoWarn>$(NoWarn);MSB3270;CS0436</NoWarn>
    <ModId>ai4sts2</ModId>
    <ModOutputDir>$(Sts2Dir)/mods/$(ModId)</ModOutputDir>
    <CopyModOnBuild Condition="'$(CopyModOnBuild)' == ''">false</CopyModOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Ai4Sts2.Core/**/*.cs" Exclude="../Ai4Sts2.Core/obj/**;../Ai4Sts2.Core/bin/**" />
    <PackageReference Include="Krafs.Publicizer" Version="2.3.2" PrivateAssets="all" />
    <PackageReference Include="STS2.RitsuLib" Version="0.5.20" GeneratePathProperty="true" />
    <PackageReference Include="Miooowo.STS2RitsuLib.ModAnalyzers" Version="0.0.1" PrivateAssets="all" />
    <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="sts2" HintPath="$(Sts2DataDir)/sts2.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(Sts2DataDir)/0Harmony.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(ModId).json" />
  </ItemGroup>
  <Target Name="ValidateSts2GameInstall" BeforeTargets="ResolveAssemblyReferences">
    <Error
      Condition="!Exists('$(Sts2DataDir)/sts2.dll')"
      Text="sts2.dll not found under '$(Sts2DataDir)'; run 'just setup' or set STS2_DIR"
    />
  </Target>
  <Target Name="CopyMod" AfterTargets="Build" Condition="'$(CopyModOnBuild)' == 'true'">
    <MakeDir Directories="$(ModOutputDir)" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)/$(ModId).json" DestinationFolder="$(ModOutputDir)" />
  </Target>
</Project>
